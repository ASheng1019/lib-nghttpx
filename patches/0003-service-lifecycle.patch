From: Sheng <hsdai22@m.fudan.edu.cn>
Subject: [PATCH] Adapt service entry, supported profile and bounded shutdown

Target: nghttp2-1.70.0 after independent Retry/truncation fixes.
Status: Unikraft platform adaptation; not submitted upstream.

diff --git a/src/shrpx.cc b/src/shrpx.cc
index e514384..30816e7 100644
--- a/src/shrpx.cc
+++ b/src/shrpx.cc
@@ -1429,6 +1429,17 @@ fork_worker_process(const std::vector<InheritedUNIXDomainAddr> &iaddrs
       .quic_lingering_worker_processes = std::move(quic_lwps),
 #endif // defined(ENABLE_HTTP3)
     };
+#ifdef UNIKRAFT_NGHTTPX
+    auto native_result = worker_process_event_loop(&wpconf);
+    close(ipc_fd[0]);
+    close(ipc_fd[1]);
+    close(quic_ipc_fd[0]);
+    close(quic_ipc_fd[1]);
+    if (!native_result)
+      return std::unexpected{native_result.error()};
+    Log{NOTICE} << "Native worker stopped and resources released";
+    return WorkerProcessForkResult{};
+#else
     if (!worker_process_event_loop(&wpconf)) {
       Log{FATAL} << "Worker process returned error";
 
@@ -1447,6 +1458,7 @@ fork_worker_process(const std::vector<InheritedUNIXDomainAddr> &iaddrs
     } else {
       nghttp2_Exit(EXIT_SUCCESS);
     }
+#endif
   }
 
   // parent process
@@ -1567,6 +1579,14 @@ std::expected<void, Error> event_loop() {
     return std::unexpected{maybe_fork_res.error()};
   }
 
+#ifdef UNIKRAFT_NGHTTPX
+  shutdown_worker_process_ready_ipc_watcher(loop);
+  close(worker_process_ready_ipc_fd[0]);
+  close(worker_process_ready_ipc_fd[1]);
+  ev_loop_destroy(loop);
+  return {};
+#endif
+
   const auto &fork_res = *maybe_fork_res;
 
   ev_timer_init(&worker_process_grace_period_timer,
@@ -5234,6 +5254,27 @@ int main(int argc, char **argv) {
     return -1;
   }
 
+#ifdef UNIKRAFT_NGHTTPX
+  auto *native_config = mod_config();
+  // This native service exposes HTTP/3 only. process_options creates a
+  // default TCP frontend when the user supplies only a QUIC frontend.
+  native_config->conn.listener.addrs.clear();
+  if (!native_config->single_process || !native_config->single_thread ||
+      native_config->num_worker != 1 || native_config->daemon ||
+      !native_config->user.empty() ||
+      native_config->conn.quic_listener.addrs.empty() ||
+      native_config->quic.upstream.early_data) {
+    Log{FATAL} << "Native mode requires single-process, one worker, IPv4/IPv6 "
+                  "QUIC listeners, no user/daemon/early-data";
+    return -1;
+  }
+  const auto &native_addr = native_config->conn.quic_listener.addrs.front();
+  if (native_addr.family != AF_INET && native_addr.family != AF_INET6) {
+    Log{FATAL} << "Native QUIC listener requires an IPv4 or IPv6 address";
+    return -1;
+  }
+#endif
+
   if (!event_loop()) {
     return -1;
   }
@@ -5245,4 +5286,6 @@ int main(int argc, char **argv) {
 
 } // namespace shrpx
 
-int main(int argc, char **argv) { return run_app(shrpx::main, argc, argv); }
+int nghttpx_main(int argc, char **argv) {
+  return run_app(shrpx::main, argc, argv);
+}
diff --git a/src/shrpx.h b/src/shrpx.h
