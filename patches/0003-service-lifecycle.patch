+#include "native_runtime.h"
+#define nghttp2_Exit(status) native_fatal_exit(status)
+#elif !defined(HAVE__EXIT)
 #  define nghttp2_Exit(status) _exit(status)
 #else // defined(HAVE__EXIT)
 #  define nghttp2_Exit(status) _Exit(status)
diff --git a/src/shrpx_worker_process.cc b/src/shrpx_worker_process.cc
index 4e620b6..d7dcfa0 100644
--- a/src/shrpx_worker_process.cc
+++ b/src/shrpx_worker_process.cc
@@ -67,6 +67,10 @@
 
 using namespace nghttp2;
 
+#ifdef UNIKRAFT_NGHTTPX
+#include "native_runtime.h"
+#endif
+
 namespace shrpx {
 
 namespace {
@@ -678,7 +682,20 @@ worker_process_event_loop(WorkerProcessConfig *wpconf) {
     return rv;
   }
 
+#ifdef UNIKRAFT_NGHTTPX
+  if (!native_watch_stop(
+          loop,
+          [](void *p) {
+            graceful_shutdown(static_cast<ConnectionHandler *>(p));
+          },
+          conn_handler.get())) {
+    return std::unexpected{Error::LIBC};
+  }
+#endif
   ev_run(loop, 0);
+#ifdef UNIKRAFT_NGHTTPX
+  native_unwatch_stop(loop);
+#endif
 
   // Destroy SSL_CTX held in conn_handler before killing neverbleed
   // daemon.  Otherwise priv_rsa_finish yields "write error" and
