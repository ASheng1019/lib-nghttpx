 #endif // !defined(UDP_SEGMENT)
     };
   } tx_{};
diff --git a/src/shrpx_quic.cc b/src/shrpx_quic.cc
index b91654a..c8fc3aa 100644
--- a/src/shrpx_quic.cc
+++ b/src/shrpx_quic.cc
@@ -54,6 +54,10 @@ bool operator==(const ngtcp2_cid &lhs, const ngtcp2_cid &rhs) {
   return ngtcp2_cid_eq(&lhs, &rhs);
 }
 
+#ifdef UNIKRAFT_NGHTTPX
+#include "native_runtime.h"
+#endif
+
 namespace shrpx {
 
 ngtcp2_tstamp quic_timestamp() {
@@ -88,6 +92,11 @@ int quic_send_packet(const UpstreamAddr *faddr, const sockaddr *remote_sa,
     .iov_len = data.size(),
   };
 
+#ifdef UNIKRAFT_NGHTTPX
+  if (remote_sa->sa_family != local_sa->sa_family || data.size() != gso_size ||
+      data.size() > native_max_payload())
+    return -EINVAL;
+#endif
   uint8_t msg_ctrl[CMSG_SPACE(sizeof(int)) +
 #ifdef UDP_SEGMENT
                    CMSG_SPACE(sizeof(uint16_t)) +
diff --git a/src/shrpx_quic_listener.cc b/src/shrpx_quic_listener.cc
index beacb4e..5a80868 100644
--- a/src/shrpx_quic_listener.cc
+++ b/src/shrpx_quic_listener.cc
@@ -27,6 +27,10 @@
 #include "shrpx_config.h"
 #include "shrpx_log.h"
 
+#ifdef UNIKRAFT_NGHTTPX
+#include "native_runtime.h"
+#endif
+
 namespace shrpx {
 
 namespace {
@@ -51,7 +55,12 @@ QUICListener::~QUICListener() {
 
 void QUICListener::on_read() {
   Address remote_addr;
+#ifdef UNIKRAFT_NGHTTPX
+  static std::array<uint8_t, 65536>
+      buf; // One event-loop worker; avoids a large stack allocation.
+#else
   std::array<uint8_t, 64_k> buf;
+#endif
   size_t pktcnt = 0;
   iovec msg_iov{
     .iov_base = buf.data(),
@@ -109,10 +118,20 @@ void QUICListener::on_read() {
     local_addr.port(faddr_->port);
 
     ngtcp2_pkt_info pi{
-      .ecn = util::msghdr_get_ecn(&msg, ss.ss_family),
+#ifdef UNIKRAFT_NGHTTPX
+        .ecn = static_cast<uint8_t>(
+            native_ecn_enabled() ? util::msghdr_get_ecn(&msg, ss.ss_family)
+                                 : 0),
+#else
+        .ecn = util::msghdr_get_ecn(&msg, ss.ss_family),
+#endif
     };
 
+#ifdef UNIKRAFT_NGHTTPX
+    size_t gso_size = 0; // Native socket has no UDP_GRO.
+#else
     auto gso_size = util::msghdr_get_udp_gro(&msg);
+#endif
     if (gso_size == 0) {
       gso_size = static_cast<size_t>(nread);
     }
