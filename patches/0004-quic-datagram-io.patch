From: Sheng <hsdai22@m.fudan.edu.cn>
Subject: [PATCH] Adapt QUIC datagram I/O, metadata and bounded buffers

Target: nghttp2-1.70.0 after independent Retry/truncation fixes.
Status: Unikraft platform adaptation; not submitted upstream.

diff --git a/src/shrpx_http3_upstream.cc b/src/shrpx_http3_upstream.cc
index af77e14..3d645ef 100644
--- a/src/shrpx_http3_upstream.cc
+++ b/src/shrpx_http3_upstream.cc
@@ -47,6 +47,10 @@
 #include "http3.h"
 #include "util.h"
 
+#ifdef UNIKRAFT_NGHTTPX
+#include "native_runtime.h"
+#endif
+
 namespace shrpx {
 
 namespace {
@@ -600,6 +604,10 @@ Http3Upstream::init(const UpstreamAddr *faddr, const Address &remote_addr,
 
   ngtcp2_settings settings;
   ngtcp2_settings_default(&settings);
+#ifdef UNIKRAFT_NGHTTPX
+  settings.no_pmtud = !native_pmtud_enabled();
+  settings.max_tx_udp_payload_size = native_max_payload();
+#endif
   if (quicconf.upstream.debug.log) {
     settings.log_write = log_write;
   }
@@ -629,6 +637,9 @@ Http3Upstream::init(const UpstreamAddr *faddr, const Address &remote_addr,
 
   ngtcp2_transport_params params;
   ngtcp2_transport_params_default(&params);
+#ifdef UNIKRAFT_NGHTTPX
+  params.disable_active_migration = 1;
+#endif
   params.initial_max_streams_bidi = http3conf.upstream.max_concurrent_streams;
   // The minimum number of unidirectional streams required for HTTP/3.
   params.initial_max_streams_uni = 3;
@@ -831,8 +842,14 @@ ngtcp2_ssize Http3Upstream::write_pkt(ngtcp2_path *path, ngtcp2_pkt_info *pi,
     }
 
     auto nwrite = ngtcp2_conn_writev_stream(
-      conn_, path, pi, dest, destlen, &ndatalen, flags, stream_id,
-      reinterpret_cast<const ngtcp2_vec *>(v), vcnt, ts);
+        conn_, path,
+#ifdef UNIKRAFT_NGHTTPX
+        native_ecn_enabled() ? pi : nullptr,
+#else
+        pi,
+#endif
+        dest, destlen, &ndatalen, flags, stream_id,
+        reinterpret_cast<const ngtcp2_vec *>(v), vcnt, ts);
     if (nwrite < 0) {
       switch (nwrite) {
       case NGTCP2_ERR_STREAM_DATA_BLOCKED:
@@ -916,15 +933,24 @@ std::expected<size_t, Error> Http3Upstream::on_stream_write(int64_t stream_id,
 
 std::expected<void, Error> Http3Upstream::write_streams() {
   ngtcp2_path_storage ps;
-  ngtcp2_pkt_info pi;
+  ngtcp2_pkt_info pi{};
   auto txbuf = std::span{txbuf_};
   size_t gso_size = 0;
 
   ngtcp2_path_storage_zero(&ps);
 
+#ifdef UNIKRAFT_NGHTTPX
+  auto ts = quic_timestamp();
+  auto nwrite = write_pkt(&ps.path, native_ecn_enabled() ? &pi : nullptr,
+                          txbuf.data(), native_max_payload(), ts);
+  gso_size = nwrite > 0 ? static_cast<size_t>(nwrite) : 0;
+  if (nwrite >= 0)
+    ngtcp2_conn_update_pkt_tx_time(conn_, ts);
+#else
   auto nwrite = ngtcp2_conn_write_aggregate_pkt(
     conn_, &ps.path, &pi, txbuf.data(), txbuf.size(), &gso_size,
     shrpx::write_pkt, quic_timestamp());
+#endif
   if (nwrite < 0) {
     return handle_error();
   }
@@ -948,7 +974,12 @@ void Http3Upstream::send_packet(const ngtcp2_path &path,
     send_packet(faddr, path.remote.addr, path.remote.addrlen, path.local.addr,
                 path.local.addrlen, pi, data, gso_size);
   if (!rest.empty()) {
+#ifdef UNIKRAFT_NGHTTPX
+    // Keep packet boundaries when the retained suffix has multiple datagrams.
+    on_send_blocked(path, pi, rest, gso_size);
+#else
     on_send_blocked(path, pi, rest, rest.size());
+#endif
 
     signal_write_upstream_addr(faddr);
   }
@@ -1839,7 +1870,12 @@ Http3Upstream::send_packet(const UpstreamAddr *faddr, const sockaddr *remote_sa,
     for (; !data.empty();) {
       auto len = std::min(gso_size, data.size());
       auto rv = quic_send_packet(faddr, remote_sa, remote_salen, local_sa,
-                                 local_salen, pi, data.first(len), gso_size);
+                                 local_salen, pi, data.first(len),
+#ifdef UNIKRAFT_NGHTTPX
+                                 len); // The final datagram may be shorter.
+#else
+                                 gso_size);
+#endif
       if (rv != 0) {
         switch (rv) {
         case -EAGAIN:
@@ -1956,14 +1992,24 @@ std::expected<void, Error> Http3Upstream::handle_error() {
 std::expected<void, Error>
 Http3Upstream::send_connection_close(const ngtcp2_ccerr &ccerr) {
   ngtcp2_path_storage ps;
-  ngtcp2_pkt_info pi;
+  ngtcp2_pkt_info pi{};
 
   ngtcp2_path_storage_zero(&ps);
 
+#ifdef UNIKRAFT_NGHTTPX
+  std::array<uint8_t, 2048> buf;
+#else
   std::array<uint8_t, NGTCP2_MAX_UDP_PAYLOAD_SIZE> buf;
+#endif
 
   auto nwrite = ngtcp2_conn_write_connection_close(
-    conn_, &ps.path, &pi, buf.data(), buf.size(), &ccerr, quic_timestamp());
+      conn_, &ps.path,
+#ifdef UNIKRAFT_NGHTTPX
+      native_ecn_enabled() ? &pi : nullptr, buf.data(), native_max_payload(),
+#else
+      &pi, buf.data(), buf.size(),
+#endif
+      &ccerr, quic_timestamp());
   if (nwrite < 0) {
     if (nwrite != NGTCP2_ERR_INVALID_STATE) {
       Log{ERROR, this} << "ngtcp2_conn_write_connection_close: "
diff --git a/src/shrpx_http3_upstream.h b/src/shrpx_http3_upstream.h
index f2becc3..ab79167 100644
--- a/src/shrpx_http3_upstream.h
+++ b/src/shrpx_http3_upstream.h
@@ -231,8 +231,8 @@ private:
       size_t gso_size;
     } blocked;
     bool no_gso{
-#ifndef UDP_SEGMENT
-      true
+#if !defined(UDP_SEGMENT) || defined(UNIKRAFT_NGHTTPX)
