# SPDX-License-Identifier: BSD-3-Clause
$(eval $(call addlib_s,libnghttpx,$(CONFIG_LIBNGHTTPX)))
LIBNGHTTPX_URL := https://github.com/nghttp2/nghttp2/releases/download/v1.70.0/nghttp2-1.70.0.tar.xz
LIBNGHTTPX_ORIGIN_SHA256 := e05cb1388eaca3830aded4ccf20044b6e1ac1a61411dcca11b0437c4285c8bc2
$(eval $(call fetch,libnghttpx,$(LIBNGHTTPX_URL)))
$(eval $(call patch,libnghttpx,$(LIBNGHTTPX_BASE)/patches,nghttp2-1.70.0))
LIBNGHTTPX_SRC := $(LIBNGHTTPX_ORIGIN)/nghttp2-1.70.0
LIBNGHTTPX_CXXFLAGS-y += -std=c++23 -fexceptions -frtti -DHAVE_CONFIG_H
LIBNGHTTPX_CFLAGS-y += -DHAVE_CONFIG_H -U__ARM_NEON -U__ARM_NEON__
LIBNGHTTPX_CXXINCLUDES-y += -I$(LIBNGHTTPX_BASE)/private -I$(LIBNGHTTPX_BASE)/include -I$(LIBNGHTTPX_BASE) -I$(LIBNGHTTPX_SRC)/src -I$(LIBNGHTTPX_SRC)/third-party/urlparse -I$(LIBNGHTTPX_SRC)/third-party/llhttp/include
LIBNGHTTPX_CINCLUDES-y += $(LIBNGHTTPX_CXXINCLUDES-y)
CINCLUDES-$(CONFIG_LIBNGHTTPX) += -I$(LIBNGHTTPX_BASE)/include
CXXINCLUDES-$(CONFIG_LIBNGHTTPX) += -I$(LIBNGHTTPX_BASE)/include
LDFLAGS-$(CONFIG_LIBNGHTTPX) += -Wl,--wrap=clock_gettime -Wl,--wrap=gettimeofday -Wl,--wrap=time
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/util.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/http2.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/timegm.c
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/app_helper.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/tls.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/network.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_config.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_accept_handler.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_connection_handler.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_client_handler.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_http2_upstream.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_https_upstream.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_downstream.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_downstream_connection.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_http_downstream_connection.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_http2_downstream_connection.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_http2_session.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_downstream_queue.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_log.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_http.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_io_control.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_tls.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_worker.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_log_config.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_connect_blocker.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_live_check.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_downstream_connection_pool.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_rate_limit.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_connection.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_memcached_dispatcher.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_memcached_connection.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_worker_process.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_signal.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_router.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_api_downstream_connection.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_health_monitor_downstream_connection.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_null_downstream_connection.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_dns_resolver.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_dual_dns_resolver.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_dns_tracker.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/xsi_strerror.c
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_quic_listener.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_quic_connection_handler.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_http3_upstream.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/http3.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/siphash.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx_quic.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/src/shrpx.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/third-party/urlparse/urlparse.c
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/third-party/llhttp/src/api.c
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/third-party/llhttp/src/http.c
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_SRC)/third-party/llhttp/src/llhttp.c
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_BASE)/native_runtime.cc
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_BASE)/native_network.c
LIBNGHTTPX_SRCS-y += $(LIBNGHTTPX_BASE)/entry.cc
